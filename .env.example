# Copy to .env and fill in when you flip MOCK_MODE=0. NEVER commit the real .env.

# Master switch. 1 = canned agent output, zero Bobcoins. 0 = real Bob Shell + Granite.
MOCK_MODE=1

# --- Bob Shell (real mode) ---
# Install: irm https://bob.ibm.com/download/bobshell.ps1 | iex   (binary is `bob`)
# We call bob.js directly via node (the `bob` shim is a .ps1/.cmd Python can't launch on Windows).
# Defaults below match a global npm install; override only if yours differs.
BOB_NODE=node
BOB_JS=%APPDATA%\npm\node_modules\bobshell\dist\bob.js
# Create an API key with Scope = Inference, FROM INSIDE the ibm-coding-challenge-uat instance
# (the instance is baked into the key; there is no --instance flag). Do NOT commit the real key.
BOB_API_KEY=
# Only needed if your key type is 'general' rather than 'Inference':
BOB_TEAM_ID=
# agent | plan | ask
BOB_MODE=agent
# Per-call Bobcoin ceiling (budget guard — you have 40 total).
BOB_MAX_COST=1.0

# --- watsonx.ai Granite (real mode) ---
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Granite-first: the hackathon guide penalizes some non-IBM models. Use a Granite model id.
# Verified available on watsonx us-south (2026-09-26); older granite-3-8b-instruct is gone.
GRANITE_MODEL_ID=ibm/granite-4-h-small

# Number of parallel hypothesis subagents in the race (keep at 3 to protect the 40-Bobcoin budget)
RACE_WIDTH=3
